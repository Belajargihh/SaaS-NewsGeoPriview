# Google Gemini AI API Key (Dapatkan gratis di https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Custom Search API
CUSTOM_SEARCH_API_KEY=your_custom_search_api_key_here
CUSTOM_SEARCH_CX=your_custom_search_cx_here

# LocationIQ Geocoding API Key (Dapatkan gratis di https://locationiq.com/)
LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# Midtrans Payment Gateway (Mode Sandbox: https://dashboard.midtrans.com/)
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here

# Server Port (Default: 5000)
PORT=5000
